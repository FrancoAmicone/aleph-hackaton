{
  "name": "test-msg",
  "version": "1.0.0",
  "description": "Chat P2P de terminal - prueba de flujo Pear OTA",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://9nbjjp5jmtxxq3jj8ko7z4sdfnohucgwyjsxspdpsnuc8yf136my",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "node node_modules/bare-runtime/bin/bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name test-msg --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name test-msg --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name test-msg --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name test-msg --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name test-msg --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name test-msg --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs",
    "start:updates": "node node_modules/bare-runtime/bin/bare bin.mjs --updates",
    "diag": "node diag-node.js"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-tty": "^5.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.0.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hello-pear-bare.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hello-pear-bare/issues"
  },
  "productName": "test-msg"
}
